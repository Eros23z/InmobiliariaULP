@model InmobiliariaULP.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<h2>Editar Pago #@Model.IdPago</h2>
<div class="alert alert-warning py-2 mb-3">
    <i class="bi bi-info-circle"></i> Por regla de auditoría, <strong>solo se puede rectificar el concepto</strong>. La fecha y el monto registrado no son editables.
</div>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.IdPago" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" name="id" value="@Model.IdPago" />

            <div class="mb-3">
                <label class="form-label">Reserva Vinculada</label>
                <input type="text" class="form-control bg-light" value="Reserva #@Model.IdReserva - @Model.Reserva?.Inquilino?.Apellido (@Model.Reserva?.Inmueble?.Direccion)" readonly />
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Fecha de Cobro (Inmutable)</label>
                    <input type="text" class="form-control bg-light" value="@Model.FechaPago.ToString("dd/MM/yyyy")" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Monto Abonado (Inmutable)</label>
                    <input type="text" class="form-control bg-light" value="$@Model.Importe.ToString("N2")" readonly />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Concepto" class="form-label"></label>
                <input asp-for="Concepto" class="form-control" />
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Actualizar Concepto</button>
                <a asp-action="Index" asp-route-idReserva="@Model.IdReserva" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}