@model InmobiliariaULP.Models.Pago

@{
    ViewData["Title"] = "Anular Pago";
}

<h2 class="text-danger">Anular Registro de Pago</h2>
<h5>¿Estás seguro de que deseas anular esta transacción?</h5>
<div class="alert alert-danger py-2">
    El registro no se borrará físicamente; quedará registrado como <strong>ANULADO</strong> y su importe se descontará del total cobrado.
</div>
<hr />

<div class="card border-danger shadow-sm col-md-6 mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">N° Transacción</dt>
            <dd class="col-sm-8">#@Model.IdPago</dd>

            <dt class="col-sm-4">Reserva</dt>
            <dd class="col-sm-8">#@(Model.Reserva?.Inmueble?.Direccion ?? "Sin direccion")</dd>

            <dt class="col-sm-4">Concepto</dt>
            <dd class="col-sm-8">@Model.Concepto</dd>

            <dt class="col-sm-4">Importe</dt>
            <dd class="col-sm-8"><strong>$@Model.Importe.ToString("N2")</strong></dd>

            <dt class="col-sm-4">Fecha</dt>
            <dd class="col-sm-8">@Model.FechaPago.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdPago" />
    <button type="submit" class="btn btn-danger">Confirmar Anulación</button>
    <a asp-action="Index" asp-route-idReserva="@Model.IdReserva" class="btn btn-secondary">Cancelar</a>
</form>