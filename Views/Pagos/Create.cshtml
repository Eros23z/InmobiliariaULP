@model InmobiliariaULP.Models.Pago

@{
    ViewData["Title"] = "Registrar Cobro";
}

<h2>Registrar Cobro de Pago</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="IdReserva" class="form-label"></label>
                <select asp-for="IdReserva" class="form-select" asp-items="ViewBag.IdReserva">
                    <option value="">-- Seleccionar Reserva --</option>
                </select>
                <span asp-validation-for="IdReserva" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Concepto" class="form-label"></label>
                <input asp-for="Concepto" class="form-control" placeholder="Ej: Seña del 50%, Saldo total de estadía..." />
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FechaPago" class="form-label"></label>
                    <input asp-for="FechaPago" class="form-control" type="date" />
                    <span asp-validation-for="FechaPago" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Importe" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Importe" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="Importe" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Registrar Pago</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}