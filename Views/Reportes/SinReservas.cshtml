@model IEnumerable<InmobiliariaULP.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles Sin Reservas";
    int dias = ViewBag.Dias ?? 30;
}

<h2>Inmuebles Sin Actividad Reciente</h2>
<hr />

<form asp-action="SinReservas" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label fw-bold">Sin reservas en los últimos:</label>
        <div class="input-group">
            <input type="number" name="dias" class="form-control" value="@dias" min="1" max="365" />
            <span class="input-group-text">días</span>
        </div>
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-warning"><i class="bi bi-filter"></i> Filtrar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr>
                <th>Dirección</th>
                <th>Tipo</th>
                <th>Dueño</th>
                <th>Precio Diario</th>
                <th>Disponibilidad</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">Todos los inmuebles registraron actividad en el período consultado.</td>
                </tr>
            }else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Direccion</td>
                        <td>@item.TipoInmueble?.Descripcion</td>
                        <td>@item.Propietario?.Apellido, @item.Propietario?.Nombre</td>
                        <td>$@item.PrecioPorDia.ToString("N2")</td>
                        <td>
                            <span class="badge @(item.Disponible ? "bg-success" : "bg-danger")">
                                @(item.Disponible ? "Habilitado" : "Deshabilitado")
                            </span>
                        </td>
                    </tr>
                }
            }
            
        </tbody>
    </table>
</div>