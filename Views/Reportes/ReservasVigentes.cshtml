@model IEnumerable<InmobiliariaULP.Models.Reserva>

@{
    ViewData["Title"] = "Reservas Vigentes en Período";
}

<h2>Reservas Vigentes en Rango</h2>
<hr />

<form asp-action="ReservasVigentes" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label fw-bold">Desde:</label>
        <input type="date" name="desde" class="form-control" value="@ViewBag.Desde" required />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Hasta:</label>
        <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta" required />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-info text-white"><i class="bi bi-calendar3"></i> Filtrar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr>
                <th>N°</th>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Monto / Día</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">No existen reservas vigentes en el rango de fechas indicado.</td>
                </tr>
            }else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.IdReserva</td>
                        <td>@item.Inmueble?.Direccion</td>
                        <td>@item.Inquilino?.Apellido, @item.Inquilino?.Nombre</td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>$@item.MontoDiario.ToString("N2")</td>
                    </tr>
                }
            }
            
        </tbody>
    </table>
</div>