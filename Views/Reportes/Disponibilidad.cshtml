@model IEnumerable<InmobiliariaULP.Models.Inmueble>

@{
    ViewData["Title"] = "Buscador de Disponibilidad";
}

<h2>Buscador de Inmuebles Disponibles</h2>
<hr />

<form asp-action="Disponibilidad" method="get" class="card shadow-sm p-3 mb-4 bg-light">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-bold">Fecha de Ingreso:</label>
            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" required />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Fecha de Egreso:</label>
            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" required />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Buscar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </div>
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr>
                <th>Dirección</th>
                <th>Tipo</th>
                <th>Cupo</th>
                <th>Precio / Día</th>
                <th>Dueño</th>
                <th class="text-end">Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">No hay inmuebles disponibles para el rango consultado o aún no ejecutó una búsqueda.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Direccion</strong></td>
                    <td>@item.TipoInmueble?.Descripcion</td>
                    <td>@item.Cupo personas</td>
                    <td>$@item.PrecioPorDia.ToString("N2")</td>
                    <td>@item.Propietario?.Apellido, @item.Propietario?.Nombre</td>
                    <td class="text-end">
                        <a asp-controller="Reservas" asp-action="Create" asp-route-idInmueble="@item.IdInmueble" class="btn btn-sm btn-success">
                            Reservar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>