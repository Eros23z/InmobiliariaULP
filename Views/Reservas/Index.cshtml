@model IEnumerable<InmobiliariaULP.Models.Reserva>

@{
    ViewData["Title"] = "Gestión de Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-calendar-check"></i> Reservas de Alquiler</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Reserva
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-action="Index" class="row g-2 mb-4 bg-light p-3 rounded shadow-sm">
    <div class="col-md-3">
        <input type="text" name="search" class="form-control" placeholder="Inquilino o Inmueble..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-2">
        <select name="estado" class="form-select">
            <option value="">-- Todos los Estados --</option>
            <option value="Vigente" selected="@(ViewBag.Estado == "Vigente")">Vigente</option>
            <option value="Finalizada" selected="@(ViewBag.Estado == "Finalizada")">Finalizada</option>
            <option value="Anulada" selected="@(ViewBag.Estado == "Anulada")">Anulada</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="fechaDesde" class="form-control" value="@ViewBag.FechaDesde" />
    </div>
    <div class="col-md-2">
        <input type="date" name="fechaHasta" class="form-control" value="@ViewBag.FechaHasta" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
    </div>
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>N°</th>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Total</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No se encontraron reservas registradas.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.IdReserva</strong></td>
                        <td>@item.Inmueble?.Direccion</td>
                        <td>@item.Inquilino?.Apellido, @item.Inquilino?.Nombre</td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td><strong>$@item.ImporteTotal.ToString("N2")</strong> (@item.CantidadDias días)</td>
                        <td>
                            @if (item.Estado == "Vigente")
                            {
                                <span class="badge bg-success">Vigente</span>
                            }
                            else if (item.Estado == "Finalizada")
                            {
                                <span class="badge bg-secondary">Finalizada</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Anulada</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-info">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-danger">Cancelar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" />