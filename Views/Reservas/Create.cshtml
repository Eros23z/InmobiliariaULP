@model InmobiliariaULP.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<h2>Registrar Reserva</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" id="formReserva">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="IdInmueble" class="form-label"></label>
                    <select asp-for="IdInmueble" class="form-select" asp-items="ViewBag.IdInmueble" id="selectInmueble">
                        <option value="">-- Seleccionar Inmueble --</option>
                    </select>
                    <span asp-validation-for="IdInmueble" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdInquilino" class="form-label"></label>
                    <select asp-for="IdInquilino" class="form-select" asp-items="ViewBag.IdInquilino">
                        <option value="">-- Seleccionar Inquilino --</option>
                    </select>
                    <span asp-validation-for="IdInquilino" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FechaInicio" class="form-label"></label>
                    <input asp-for="FechaInicio" class="form-control" type="date" id="fechaInicio" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaFin" class="form-label"></label>
                    <input asp-for="FechaFin" class="form-control" type="date" id="fechaFin" />
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="MontoDiario" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="MontoDiario" class="form-control" type="number" step="0.01" id="montoDiario" />
                    </div>
                    <span asp-validation-for="MontoDiario" class="text-danger"></span>
                </div>
            </div>

            <div class="alert alert-info py-2" id="resumenEstadia">
                <strong>Días calculados:</strong> <span id="lblDias">1</span> | <strong>Monto Total Estimado:</strong> $<span id="lblTotal">0.00</span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Confirmar Reserva</button>
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Cálculo automático de monto total y actualización dinámica por AJAX
        const selectInmueble = document.getElementById('selectInmueble');
        const fechaInicio = document.getElementById('fechaInicio');
        const fechaFin = document.getElementById('fechaFin');
        const montoDiario = document.getElementById('montoDiario');
        const lblDias = document.getElementById('lblDias');
        const lblTotal = document.getElementById('lblTotal');

        async function actualizarPrecioInmueble() {
            const id = selectInmueble.value;
            if (!id) return;
            try {
                const response = await fetch(`/Inmuebles/ObtenerPrecio/${id}`);
                if (response.ok) {
                    const data = await response.json();
                    montoDiario.value = data.precio;
                    calcularTotales();
                }
            } catch (err) {
                console.error(err);
            }
        }

        function calcularTotales() {
            const f1 = new Date(fechaInicio.value);
            const f2 = new Date(fechaFin.value);
            const diffTime = f2 - f1;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            const dias = diffDays > 0 ? diffDays : 1;
            const precio = parseFloat(montoDiario.value) || 0;

            lblDias.textContent = dias;
            lblTotal.textContent = (dias * precio).toLocaleString('es-AR', { minimumFractionDigits: 2 });
        }

        selectInmueble.addEventListener('change', actualizarPrecioInmueble);
        fechaInicio.addEventListener('change', calcularTotales);
        fechaFin.addEventListener('change', calcularTotales);
        montoDiario.addEventListener('input', calcularTotales);

        calcularTotales();
    </script>
}