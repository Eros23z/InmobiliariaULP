@model InmobiliariaULP.Models.Reserva

@{
    ViewData["Title"] = "Detalle de Reserva";
}

<h2>Detalles de la Reserva #@Model.IdReserva</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Reserva de Estadía</h5>
                <span class="badge @(Model.Estado == "Vigente" ? "bg-success" : "bg-secondary")">@Model.Estado</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h5>Datos del Inmueble</h5>
                        <strong>Dirección:</strong> @Model.Inmueble?.Direccion <br />
                        <strong>Tipo:</strong> @Model.Inmueble?.TipoInmueble?.Descripcion <br />
                        <strong>Propietario:</strong> @Model.Inmueble?.Propietario?.Apellido, @Model.Inmueble?.Propietario?.Nombre <br />
                        <strong>Teléfono Dueño:</strong> @Model.Inmueble?.Propietario?.Telefono
                    </div>
                    <div class="col-md-6">
                        <h5>Datos del Inquilino</h5>
                        <strong>Inquilino:</strong> @Model.Inquilino?.Apellido, @Model.Inquilino?.Nombre <br />
                        <strong>DNI:</strong> @Model.Inquilino?.Dni <br />
                        <strong>Teléfono:</strong> @Model.Inquilino?.Telefono <br />
                        <strong>Email:</strong> @Model.Inquilino?.Email
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6">
                        <h5>Período de Alquiler</h5>
                        <strong>Fecha Desde:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy") <br />
                        <strong>Fecha Hasta:</strong> @Model.FechaFin.ToString("dd/MM/yyyy") <br />
                        <strong>Fecha Original:</strong> @Model.FechaFinOriginal?.ToString("dd/MM/yyyy") <br />
                        <strong>Total Estadía:</strong> @Model.CantidadDias días
                    </div>
                    <div class="col-md-6">
                        <h5>Importes Económicos</h5>
                        <strong>Precio por Día:</strong> $@Model.MontoDiario.ToString("N2") <br />
                        <strong>Importe Total:</strong> <span class="h5 text-primary">$@Model.ImporteTotal.ToString("N2")</span> <br />
                        @if (Model.Multa > 0)
                        {
                            <strong>Multa Aplicada:</strong> <span class="text-danger">$@Model.Multa.ToString("N2")</span>
                        }
                    </div>
                </div>

                <hr />

                <!-- Tabla de pagos -->
                <div class="mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4><i class="bi bi-cash-coin"></i> Pagos Registrados de la Reserva</h4>
                        <a asp-controller="Pagos" asp-action="Create" asp-route-idReserva="@Model.IdReserva" class="btn btn-sm btn-success">
                            <i class="bi bi-plus-circle"></i> Cargar Pago a esta Reserva
                        </a>
                    </div>

                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Concepto</th>
                                    <th>Importe</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Pagos == null || !Model.Pagos.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-muted">Aún no se registraron pagos para esta reserva.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in Model.Pagos)
                                    {
                                        <tr class="@(p.Anulado ? "text-muted text-decoration-line-through bg-light" : "")">
                                            <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                                            <td>@p.Concepto</td>
                                            <td><strong>$@p.Importe.ToString("N2")</strong></td>
                                            <td>
                                                @if (p.Anulado)
                                                {
                                                    <span class="badge bg-danger">Anulado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Acreditado</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Pagos" asp-action="Details" asp-route-id="@p.IdPago" class="btn btn-xs btn-outline-info">Ver</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2">
                @if (Model.Estado == "Vigente")
                {
                    <a asp-action="Finalizar" asp-route-id="@Model.IdReserva" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle"></i> Finalizar con Multa
                    </a>
                }

                <a asp-action="Renovar" asp-route-id="@Model.IdReserva" class="btn btn-outline-success">
                    <i class="bi bi-arrow-repeat"></i> Extender / Renovar
                </a>

                <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-warning">Editar</a>
                <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
            </div>
            @if (User.IsInRole("Administrador") || !User.Identity?.IsAuthenticated != true)
            {
                <div class="alert alert-secondary mt-3 py-2">
                    <h6 class="alert-heading mb-1"><i class="bi bi-shield-lock"></i> Auditoría</h6>
                    <small>
                        <strong>Creada por:</strong> @(Model.UsuarioCrea?.NombreCompleto ?? "Sistema") @($"({Model.UsuarioCrea?.Email ?? "-"})") <br />
                        @if (Model.UsuarioTerminaId.HasValue)
                        {
                            <strong>Finalizada por:</strong> 
                            @(Model.UsuarioTermina?.NombreCompleto ?? "Desconocido") @($"({Model.UsuarioTermina?.Email ?? "-"})")
                        }
                    </small>
                </div>
            }
        </div>
    </div>
</div>