@model InmobiliariaULP.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<h2>Editar Inmueble</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="IdInmueble" />

            <div class="row mb-3">
                <div class="col-md-8">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Cupo" class="form-label"></label>
                    <input asp-for="Cupo" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Cupo" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="IdPropietario" class="form-label"></label>
                    <select asp-for="IdPropietario" class="form-select" asp-items="ViewBag.IdPropietario"></select>
                    <span asp-validation-for="IdPropietario" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdTipoInmueble" class="form-label"></label>
                    <select asp-for="IdTipoInmueble" class="form-select" asp-items="ViewBag.IdTipoInmueble"></select>
                    <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="PrecioPorDia" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PorcentajeReserva" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Latitud" class="form-label"></label>
                    <input asp-for="Latitud" class="form-control" type="number" step="0.00000001" />
                    <span asp-validation-for="Latitud" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Longitud" class="form-label"></label>
                    <input asp-for="Longitud" class="form-control" type="number" step="0.00000001" />
                    <span asp-validation-for="Longitud" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ImagenPortada" class="form-label"></label>
                <input asp-for="ImagenPortada" class="form-control" />
                <span asp-validation-for="ImagenPortada" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Disponible" />
                <label class="form-check-label" asp-for="Disponible"></label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Actualizar Inmueble</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}