@model IEnumerable<InmobiliariaULP.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-houses"></i> Inmuebles</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Publicar Inmueble
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-action="Index" class="row g-2 mb-4 bg-light p-3 rounded shadow-sm">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Dirección o Propietario..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-3">
        <select name="tipoId" class="form-select" asp-items="ViewBag.TiposFiltro">
            <option value="">-- Todos los Tipos --</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="soloDisponibles" id="soloDisponibles" value="true" @(ViewBag.SoloDisponibles == true ? "checked" : "") />
            <label class="form-check-label" for="soloDisponibles">Solo disponibles</label>
        </div>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
    </div>
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Dirección</th>
                <th>Tipo</th>
                <th>Propietario</th>
                <th>Cupo</th>
                <th>Precio / Día</th>
                <th>Disponibilidad</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No se encontraron inmuebles con los criterios seleccionados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Direccion</strong></td>
                        <td><span class="badge bg-info text-dark">@item.TipoInmueble?.Descripcion</span></td>
                        <td>@item.Propietario?.Apellido, @item.Propietario?.Nombre</td>
                        <td>@item.Cupo pers.</td>
                        <td>$@item.PrecioPorDia.ToString("N2")</td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Suspendido</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-outline-info">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" />