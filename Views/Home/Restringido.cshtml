@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger p-4">
                <div class="card-body">
                    <h1 class="display-1 text-danger"><i class="bi bi-shield-slash"></i> 403</h1>
                    <h3 class="mb-3">Acceso Restringido</h3>
                    <p class="text-muted mb-4">
                        No posee los permisos suficientes (rol requerido: <strong>Administrador</strong>) para ejecutar esta acción o acceder al recurso solicitado.
                    </p>
                    <a asp-controller="Inmuebles" asp-action="Index" class="btn btn-primary">
                        Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>