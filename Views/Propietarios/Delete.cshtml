@model InmobiliariaULP.Models.Propietario

@{
    ViewData["Title"] = "Eliminar Propietario";
}

<h2 class="text-danger">Eliminar Propietario</h2>
<h5>¿Estás seguro de que deseas eliminar este registro?</h5>
<hr />

<div class="card border-danger shadow-sm col-md-6 mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Dni)</dt>
            <dd class="col-sm-8">@Model.Dni</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellido)</dt>
            <dd class="col-sm-8">@Model.Apellido</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-8">@Model.Email</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdPropietario" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>